{
  "name": "nixtla-mcp-server",
  "version": "1.0.0",
  "description": "Production-ready MCP server for multitenant Nixtla TimeGPT forecasting with fine-tuning and backtesting",
  "main": "dist/api/mcp.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api/mcp.ts",
    "build": "tsc",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nixtla",
    "timegpt",
    "forecasting",
    "time-series",
    "ai",
    "machine-learning",
    "vercel"
  ],
  "author": "Nixtla MCP Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VaclavRut/nixtla-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/VaclavRut/nixtla-mcp/issues"
  },
  "homepage": "https://github.com/VaclavRut/nixtla-mcp#readme",
  "dependencies": {
    "@vercel/blob": "^2.0.0",
    "@vercel/node": "^3.0.12",
    "mongodb": "^7.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
