# Nixtla TimeGPT API Key
# Get yours at: https://dashboard.nixtla.io
NIXTLA_API_KEY=your_nixtla_api_key_here

# HMAC Secret for Authentication Token Hashing
# Generate a secure random string (e.g., using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
MCP_AUTH_TOKEN_SECRET=your_strong_random_secret_here

# Admin Setup Token for Bootstrap Endpoint
# Generate a secure random string (e.g., using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ADMIN_SETUP_TOKEN=your_admin_token_here

# MongoDB Connection String
# Option 1: MongoDB Atlas (recommended): mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Option 2: Local MongoDB: mongodb://localhost:27017/nixtla-mcp
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Vercel Blob Storage Token
# Get from Vercel Dashboard: Storage → Blob → Copy Token
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Optional: Base URL for your deployment (auto-detected if not set)
# BASE_URL=https://your-deployment.vercel.app
